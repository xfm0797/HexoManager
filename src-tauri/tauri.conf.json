{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HexoManager",
  "version": "1.0.1-rc.1",
  "identifier": "com.xfm.hexomanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:only",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "HexoManager",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DOCUMENT/**", "$DESKTOP/**", "$TEMP/**"]
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 XFM. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "Hexo 多站点管理工具",
    "longDescription": "HexoManager 是一款桌面端 Hexo 多站点管理工具，提供可视化的站点管理、文章编辑、主题配置和一键部署能力。",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0MURFREQ5MjQyRTk2QjMKUldTemxpNGsyZTBkZEErY1A1UUNvbFhaS0FrNERJM210Z2FRaUZWNHZnNnN6Rm54eUlNdGZrZS8K",
      "endpoints": [
        "https://github.com/xfm/hexo-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
